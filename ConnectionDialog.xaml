<hc:Window x:Class="K3CloudDataDictionary.ConnectionDialog"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="连接与数据管理"
           Icon="pack://application:,,,/Resources/app.ico"
           Width="620" Height="500"
           WindowStartupLocation="CenterOwner"
           ResizeMode="NoResize"
           ShowInTaskbar="False">

    <hc:Window.Resources>
        <BooleanToVisibilityConverter x:Key="Boolean2VisibilityConverter" />
    </hc:Window.Resources>

    <DockPanel Background="White">
        <Border DockPanel.Dock="Top"
                Background="{StaticResource AppAccentBrush}"
                Height="3" />

        <DockPanel Margin="16,14,16,12">
            <StackPanel DockPanel.Dock="Bottom"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="连接" Click="Connect_Click" Style="{StaticResource ButtonPrimary}" Margin="0,0,8,0" Padding="14,5" FontSize="12" />
                <Button Content="取消" Click="Cancel_Click" Style="{StaticResource ButtonDefault}" Padding="14,5" FontSize="12" />
            </StackPanel>

            <TabControl x:Name="MainTabControl" Margin="0,0,0,0">
                <TabItem Header="连接管理">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="#E0E4EA"
                                BorderThickness="1"
                                CornerRadius="4">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,6">
                                    <Button Click="AddConnection_Click" ToolTip="新增连接" Cursor="Hand" Width="28" Height="24" Padding="0" Style="{StaticResource ButtonDefault}">
                                        <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12" Stretch="Uniform" Fill="#6B7280" />
                                    </Button>
                                    <Button Click="DeleteConnection_Click" ToolTip="删除连接" Cursor="Hand" Width="28" Height="24" Margin="4,0,0,0" Padding="0" Style="{StaticResource ButtonDefault}">
                                        <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="12" Height="12" Stretch="Uniform" Fill="#EF4444" />
                                    </Button>
                                </StackPanel>
                                <ListBox x:Name="ConnectionList"
                                         SelectionChanged="ConnectionList_SelectionChanged"
                                         BorderThickness="0"
                                         FontSize="12"
                                         Padding="2">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="● " FontSize="10" Foreground="#326CF3" Visibility="{Binding IsCurrent, Converter={StaticResource Boolean2VisibilityConverter}}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2"
                                BorderBrush="#E0E4EA"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,10">
                            <Grid x:Name="EditPanel" IsEnabled="False">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="连接名称" Margin="0,4" FontSize="12" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="服务器" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ServerIp, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="192.168.1.100" Margin="0,4" FontSize="12" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="端口" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="1433" Margin="0,4" FontSize="12" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="用户名" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="登录用户名" Margin="0,4" FontSize="12" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="密码" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" />
                                <PasswordBox Grid.Row="4" Grid.Column="1" x:Name="PasswordBox" PasswordChanged="PasswordBox_PasswordChanged" hc:InfoElement.Placeholder="登录密码" Margin="0,4" FontSize="12" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="数据库" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}" hc:InfoElement.Placeholder="数据库名称" Margin="0,4" FontSize="12" />

                                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="测试连接" Click="TestConnection_Click" Style="{StaticResource ButtonDefault}" Margin="0,0,8,0" Padding="10,4" FontSize="12" />
                                    <Button Content="保存" Click="SaveConnection_Click" Style="{StaticResource ButtonPrimary}" Padding="10,4" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="本地数据">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：本地数据文件列表 -->
                        <Border Grid.Column="0"
                                BorderBrush="#E0E4EA"
                                BorderThickness="1"
                                CornerRadius="4">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,6">
                                    <Button Click="ImportLocalData_Click" ToolTip="导入数据文件" Cursor="Hand" Width="28" Height="24" Padding="0" Style="{StaticResource ButtonDefault}">
                                        <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="12" Height="12" Stretch="Uniform" Fill="#6B7280" />
                                    </Button>
                                    <Button Click="DeleteLocalData_Click" ToolTip="删除数据文件" Cursor="Hand" Width="28" Height="24" Margin="4,0,0,0" Padding="0" Style="{StaticResource ButtonDefault}">
                                        <Path Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Width="12" Height="12" Stretch="Uniform" Fill="#EF4444" />
                                    </Button>
                                    <Button Click="RefreshLocalData_Click" ToolTip="刷新列表" Cursor="Hand" Width="28" Height="24" Margin="4,0,0,0" Padding="0" Style="{StaticResource ButtonDefault}">
                                        <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4.01,7.58 4.01,12C4.01,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Width="12" Height="12" Stretch="Uniform" Fill="#6B7280" />
                                    </Button>
                                </StackPanel>
                                <ListBox x:Name="LocalDataList"
                                         SelectionChanged="LocalDataList_SelectionChanged"
                                         BorderThickness="0"
                                         FontSize="12"
                                         Padding="2">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="● " FontSize="10" Foreground="#326CF3" Visibility="{Binding IsCurrent, Converter={StaticResource Boolean2VisibilityConverter}}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <!-- 右侧：文件详情和操作 -->
                        <Border Grid.Column="2"
                                BorderBrush="#E0E4EA"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,10">
                            <StackPanel x:Name="LocalDataDetailPanel" IsEnabled="False">
                                <TextBlock Text="文件信息" FontWeight="SemiBold" FontSize="13" Foreground="#1F2937" Margin="0,0,0,10" />

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" />
                                    <Grid Grid.Row="0" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 自动生成的文件：显示文件名，不可编辑 -->
                                        <TextBlock x:Name="LocalDataFileNameText" Grid.Column="0"
                                                   VerticalAlignment="Center" FontSize="12" Foreground="#334155" TextTrimming="CharacterEllipsis" />
                                        <!-- 导入的文件：可编辑名称 -->
                                        <TextBox x:Name="LocalDataFileNameEdit" Grid.Column="0"
                                                 VerticalAlignment="Center" FontSize="12" Margin="0,4"
                                                 Visibility="Collapsed" />
                                        <Button x:Name="RenameLocalDataButton" Grid.Column="1"
                                                Content="重命名" Click="RenameLocalData_Click"
                                                Style="{StaticResource ButtonDefault}"
                                                Padding="6,2" FontSize="11" Margin="4,0,0,0"
                                                Visibility="Collapsed" />
                                    </Grid>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="文件大小" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LocalDataFileSizeText" VerticalAlignment="Center" FontSize="12" Foreground="#334155" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="修改时间" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LocalDataLastModifiedText" VerticalAlignment="Center" FontSize="12" Foreground="#334155" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="关联连接" VerticalAlignment="Center" FontSize="12" Foreground="#6B7280" />
                                    <Grid Grid.Row="3" Grid.Column="1">
                                        <!-- 自动生成的文件：显示关联的连接名，不可修改 -->
                                        <TextBlock x:Name="LocalDataConnectionText"
                                                   VerticalAlignment="Center" FontSize="12" Foreground="#334155"
                                                   Visibility="Collapsed" />
                                        <!-- 导入的文件：无需关联 -->
                                        <TextBlock x:Name="LocalDataNoAssociationText"
                                                   Text="导入数据（无需关联）" VerticalAlignment="Center" FontSize="12" Foreground="#9CA3AF"
                                                   Visibility="Collapsed" />
                                    </Grid>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="数据概览" VerticalAlignment="Top" FontSize="12" Foreground="#6B7280" Margin="0,8,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LocalDataSummaryText" VerticalAlignment="Top" FontSize="12" Foreground="#334155" TextWrapping="Wrap" Margin="0,8,0,0" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                    <Button Content="使用此数据" Click="ConnectWithLocalData_Click" Style="{StaticResource ButtonPrimary}" Padding="10,4" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </DockPanel>
    </DockPanel>
</hc:Window>
