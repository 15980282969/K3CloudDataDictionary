<hc:Window x:Class="K3CloudDataDictionary.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:vm="clr-namespace:K3CloudDataDictionary.ViewModels"
           xmlns:model="clr-namespace:K3CloudDataDictionary.Models"
           xmlns:local="clr-namespace:K3CloudDataDictionary"
           Title="数据字典"
           Icon="pack://application:,,,/Resources/app.ico"
           NonClientAreaBackground="#F5F7FA"
           NonClientAreaForeground="#4B5563"
           Width="1200" Height="750"
           MinWidth="900" MinHeight="600"
           WindowStartupLocation="CenterScreen">

    <hc:Window.InputBindings>
        <KeyBinding Key="W" Modifiers="Ctrl"
                    Command="{Binding CloseCurrentTabCommand}"
                    CommandParameter="{Binding SelectedTab}" />
    </hc:Window.InputBindings>

    <hc:Window.DataContext>
        <vm:MainViewModel />
    </hc:Window.DataContext>

    <hc:Window.NonClientAreaContent>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="ConnectionMenuButton" Click="ConnectionMenuButton_Click"
                    ToolTip="连接与元数据管理"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="Transparent"
                                Padding="8,4"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="BtnText"
                                           Text="实体映射管理"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#4B5563"
                                           VerticalAlignment="Center" />
                                <Path Data="M7,10L12,15L17,10H7Z"
                                      Width="8" Height="8"
                                      Stretch="Uniform"
                                      Fill="#9CA3AF"
                                      VerticalAlignment="Center"
                                      Margin="4,1,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#D1D5DB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.ContextMenu>
                    <ContextMenu x:Name="ConnectionContextMenu"
                                 Placement="Bottom"
                                 HorizontalOffset="-2"
                                 VerticalOffset="0">
                        <ContextMenu.Template>
                            <ControlTemplate TargetType="ContextMenu">
                                <Border Background="White"
                                        CornerRadius="5"
                                        BorderBrush="#D1D5DB"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.08" Color="#000000" />
                                    </Border.Effect>
                                    <ItemsPresenter Margin="2" />
                                </Border>
                            </ControlTemplate>
                        </ContextMenu.Template>
                        <ContextMenu.Resources>
                            <Style TargetType="Separator">
                                <Setter Property="Height" Value="1" />
                                <Setter Property="Margin" Value="6,3" />
                                <Setter Property="Background" Value="#E5E7EB" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Separator">
                                            <Border Background="{TemplateBinding Background}"
                                                    Height="1"
                                                    Margin="{TemplateBinding Margin}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Padding" Value="8,5" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="#374151" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="Transparent"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}"
                                                    Margin="1"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0"
                                                                      ContentSource="Icon"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Center" />
                                                    <ContentPresenter Grid.Column="1"
                                                                      ContentSource="Header"
                                                                      VerticalAlignment="Center"
                                                                      RecognizesAccessKey="True" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F3F4F6" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ContextMenu.Resources>
                        <MenuItem Header="连接管理..." Click="MenuConnection_Click">
                            <MenuItem.Icon>
                                <Path Data="M12,4A4,4 0 0,0 8,8A4,4 0 0,0 12,12A4,4 0 0,0 16,8A4,4 0 0,0 12,4M12,14C8.42,14 5,15.79 5,18V20H19V18C19,15.79 15.58,14 12,14Z" Width="14" Height="14" Stretch="Uniform" Fill="#6B7280" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="重新获取元数据" Click="RefreshMetadata_Click">
                            <MenuItem.Icon>
                                <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4.01,7.58 4.01,12C4.01,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Width="14" Height="14" Stretch="Uniform" Fill="#6B7280" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="刷新扩展元数据" Click="RefreshExtensionMetadata_Click">
                            <MenuItem.Icon>
                                <Path Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M10,17L5,12L6.41,10.59L10,14.17L17.59,6.58L19,8L10,17Z" Width="14" Height="14" Stretch="Uniform" Fill="#6B7280" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </StackPanel>
    </hc:Window.NonClientAreaContent>

    <hc:Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type model:ModuleTreeItem}"
                                   ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2,0">
                <TextBlock Text="{Binding Text}"
                           VerticalAlignment="Center"
                           FontSize="13" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="FormTabTemplate" DataType="{x:Type model:ModuleTabItem}">
            <Border Background="White" Padding="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding Header, StringFormat='表单列表 - {0}'}"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource AppAccentBrush}"
                               Margin="8,4,0,6" />
                    <DataGrid ItemsSource="{Binding Forms}"
                              Style="{StaticResource AppDataGridStyle}"
                              RowHeaderStyle="{StaticResource AppDataGridRowHeaderStyle}"
                              SelectionUnit="CellOrRowHeader"
                              LoadingRow="DataGrid_LoadingRow"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                              MouseDoubleClick="FormDataGrid_MouseDoubleClick"
                              CanUserSortColumns="True"
                              Sorting="DataGrid_Sorting">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="单据标识" Binding="{Binding FormIdentifier}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="FormIdentifier" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="单据名称" Binding="{Binding FormName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="FormName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="类型" Binding="{Binding ModelTypeName}" Width="Auto" MinWidth="60">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="ModelTypeName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="所属子系统" Binding="{Binding SubSystemName}" Width="*" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="SubSystemName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EntityTabTemplate" DataType="{x:Type model:ModuleTabItem}">
            <Border Background="White" Padding="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding Header, StringFormat='实体列表 - {0}'}"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource AppAccentBrush}"
                               Margin="8,4,0,6" />
                    <DataGrid ItemsSource="{Binding FormEntities}"
                              Style="{StaticResource AppDataGridStyle}"
                              RowHeaderStyle="{StaticResource AppDataGridRowHeaderStyle}"
                              SelectionUnit="CellOrRowHeader"
                              LoadingRow="DataGrid_LoadingRow"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                              MouseDoubleClick="EntityDataGrid_MouseDoubleClick"
                              CanUserSortColumns="True"
                              Sorting="DataGrid_Sorting">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="表单标识" Binding="{Binding FormIdentifier}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="FormIdentifier" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="单据名称" Binding="{Binding FormName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="FormName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Key" Binding="{Binding EntityKey}" Width="Auto" MinWidth="60">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="EntityKey" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="EntryName" Binding="{Binding EntityEntryName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="EntityEntryName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="实体名称" Binding="{Binding EntityName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="EntityName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="表名" Binding="{Binding EntityTableName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="EntityTableName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="分录主键" Binding="{Binding EntityEntryPkFieldName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="EntityEntryPkFieldName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="元素类型" Binding="{Binding EntityElementTypeName}" Width="*" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="EntityElementTypeName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FieldTabTemplate" DataType="{x:Type model:ModuleTabItem}">
            <Border Background="White" Padding="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{Binding Header, StringFormat='字段详情 - {0}'}"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource AppAccentBrush}"
                               Margin="8,4,0,6" />
                    <DataGrid ItemsSource="{Binding Fields}"
                              Style="{StaticResource AppDataGridStyle}"
                              RowHeaderStyle="{StaticResource AppDataGridRowHeaderStyle}"
                              SelectionUnit="Cell"
                              LoadingRow="DataGrid_LoadingRow"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                              CanUserSortColumns="True"
                              Sorting="DataGrid_Sorting">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="键" Binding="{Binding Key}" Width="Auto" MinWidth="60">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="Key" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="Auto" MinWidth="60">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="Name" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="字段名" Binding="{Binding FieldName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="FieldName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="属性名" Binding="{Binding PropertyName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="PropertyName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="元素类型" Binding="{Binding ElementTypeName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="ElementTypeName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="后缀" Binding="{Binding Suffix}" Width="Auto" MinWidth="60">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="Suffix" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="拆分说明" Binding="{Binding SplitDescription}" Width="*" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="SplitDescription" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <local:TabContentTemplateSelector x:Key="TabContentSelector"
                                          FormTemplate="{StaticResource FormTabTemplate}"
                                          EntityTemplate="{StaticResource EntityTabTemplate}"
                                          FieldTemplate="{StaticResource FieldTabTemplate}" />

        <ContextMenu x:Key="TabItemContextMenu">
            <ContextMenu.Template>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="White"
                            CornerRadius="6"
                            BorderBrush="#E0E4EA"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.15" Color="#000000" />
                        </Border.Effect>
                        <ScrollViewer CanContentScroll="True"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter Margin="4" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </ContextMenu.Template>
            <ContextMenu.Resources>
                <Style TargetType="Separator">
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Margin" Value="6,3" />
                    <Setter Property="Background" Value="#E0E4EA" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Separator">
                                <Border Background="{TemplateBinding Background}"
                                        Height="1"
                                        Margin="{TemplateBinding Margin}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <Style TargetType="MenuItem">
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Foreground" Value="#374151" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="MenuItem">
                                <Border x:Name="ItemBorder"
                                        Background="Transparent"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Grid.Column="0"
                                                          ContentSource="Icon"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center" />
                                        <ContentPresenter Grid.Column="1"
                                                          ContentSource="Header"
                                                          VerticalAlignment="Center"
                                                          RecognizesAccessKey="True" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="ItemBorder" Property="Background" Value="#EBF0F7" />
                                        <Setter Property="Foreground" Value="#2D5F8A" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="关闭当前" Click="ContextMenu_CloseCurrent">
                <MenuItem.Icon>
                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Width="14" Height="14" Stretch="Uniform" Fill="#EF4444" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="关闭左侧" Click="ContextMenu_CloseLeft">
                <MenuItem.Icon>
                    <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" Width="14" Height="14" Stretch="Uniform" Fill="#6B7280" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="关闭右侧" Click="ContextMenu_CloseRight">
                <MenuItem.Icon>
                    <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Width="14" Height="14" Stretch="Uniform" Fill="#6B7280" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="关闭其他" Click="ContextMenu_CloseOther">
                <MenuItem.Icon>
                    <Path Data="M12,2C6.47,2 2,6.47 2,12C2,17.53 6.47,22 12,22C17.53,22 22,17.53 22,12C22,6.47 17.53,2 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z" Width="14" Height="14" Stretch="Uniform" Fill="#F59E0B" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="RoundedTabItemStyle" TargetType="TabItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Background" Value="#F0F3F7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E0E4EA"
                                BorderThickness="0"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,2,0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Header}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="12" />
                                <Button x:Name="CloseButton" Grid.Column="1"
                                        Width="20" Height="20"
                                        Margin="4,0,-4,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.CloseCurrentTabCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="Collapsed">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CloseBtnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Width="20" Height="20">
                                                <TextBlock x:Name="CloseBtnText" Text="✕" FontSize="11"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CloseBtnBorder" Property="Background" Value="#FEE2E2" />
                                                    <Setter TargetName="CloseBtnText" Property="Foreground" Value="#EF4444" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#326cf3" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#F0F3F7" />
                                <Setter Property="Foreground" Value="#374151" />
                                <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </hc:Window.Resources>

    <Grid>
        <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="White"
                CornerRadius="4"
                Margin="4,0,0,0"
                Padding="12,6"
                BorderBrush="{StaticResource AppGridLineBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="表单名称"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#374151"
                           Margin="0,0,8,0" />
                <ComboBox Width="80"
                          ItemsSource="{Binding Operators}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="OperatorValue"
                          SelectedItem="{Binding SelectedOperator}"
                          Margin="0,0,8,0" />
                <TextBox Width="260"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         hc:InfoElement.Placeholder="请输入条件值"
                         KeyDown="SearchTextBox_KeyDown"
                         Margin="0,0,12,0" />
                <Button Content="查询"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource ButtonPrimary}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource AppStatusBgBrush}"
                BorderBrush="{StaticResource AppGridLineBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="#6B7280"
                           VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1"
                             x:Name="RefreshProgressBar"
                             Width="200" Height="14"
                             Minimum="0" Maximum="100" Value="0"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             Foreground="#326cf3"
                             Background="#E5E7EB" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" MaxWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource AppSideBarBrush}"
                    BorderBrush="{StaticResource AppSideBarDividerBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource AppAccentBrush}"
                            Padding="12,8">
                        <TextBlock Text="业务模块"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="14" />
                    </Border>
                    <TreeView ItemsSource="{Binding ModuleTree}"
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="{StaticResource AppSideBarTextBrush}">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2D5F8A" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2D5F8A" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#374151" />
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem"
                                   BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Padding" Value="4,2" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource AppGridLineBrush}" />

            <Border Grid.Column="2"
                    Background="White"
                    Margin="8,8,8,8">
                <hc:TabControl x:Name="MainTabControl"
                               ItemsSource="{Binding OpenTabs}"
                               SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                               Background="Transparent"
                               BorderThickness="0"
                               IsScrollable="True"
                               ShowOverflowButton="True"
                               ShowScrollButton="True"
                               ShowCloseButton="False"
                               ShowContextMenu="False"
                               IsDraggable="False"
                               OverflowMenuDisplayMemberPath="Header"
                               TabItemWidth="180"
                               TabItemHeight="34"
                               ItemContainerStyle="{StaticResource RoundedTabItemStyle}"
                               PreviewMouseRightButtonDown="MainTabControl_PreviewMouseRightButtonDown">
                    <hc:TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type model:ModuleTabItem}">
                            <TextBlock Text="{Binding Header}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </hc:TabControl.ItemTemplate>
                    <hc:TabControl.ContentTemplateSelector>
                        <local:TabContentTemplateSelector FormTemplate="{StaticResource FormTabTemplate}"
                                                         EntityTemplate="{StaticResource EntityTabTemplate}"
                                                         FieldTemplate="{StaticResource FieldTabTemplate}" />
                    </hc:TabControl.ContentTemplateSelector>
                </hc:TabControl>
            </Border>
        </Grid>
    </DockPanel>
    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False">
        <StackPanel hc:Growl.GrowlParent="True"
                    VerticalAlignment="Top"
                    Margin="0,10,10,10" />
    </ScrollViewer>
    </Grid>
</hc:Window>
