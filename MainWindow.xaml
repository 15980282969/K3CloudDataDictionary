<hc:Window x:Class="K3CloudDataDictionary.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           xmlns:vm="clr-namespace:K3CloudDataDictionary.ViewModels"
           xmlns:model="clr-namespace:K3CloudDataDictionary.Models"
           xmlns:local="clr-namespace:K3CloudDataDictionary"
           Title="数据字典"
           Icon="pack://application:,,,/Resources/app.ico"
                      NonClientAreaBackground="#F5F7FA"
           NonClientAreaForeground="#4B5563"
           Width="1200" Height="750"
           MinWidth="900" MinHeight="600"
           WindowStartupLocation="CenterScreen">

    <hc:Window.InputBindings>
        <KeyBinding Key="W" Modifiers="Ctrl"
                    Command="{Binding CloseCurrentTabCommand}"
                    CommandParameter="{Binding SelectedTab}" />
    </hc:Window.InputBindings>

    <hc:Window.DataContext>
        <vm:MainViewModel />
    </hc:Window.DataContext>

    <hc:Window.NonClientAreaContent>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="ConnectionMenuButton" Click="ConnectionMenuButton_Click"
                    ToolTip="连接与元数据管理"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="Transparent"
                                Padding="8,4"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12,4A4,4 0 0,0 8,8A4,4 0 0,0 12,12A4,4 0 0,0 16,8A4,4 0 0,0 12,4M12,14C8.42,14 5,15.79 5,18V20H19V18C19,15.79 15.58,14 12,14Z"
                                      Width="14" Height="14" Stretch="Uniform" Fill="#B3FFFFFF"
                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="BtnText"
                                           Text="实体映射管理"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#4B5563"
                                           VerticalAlignment="Center" />
                                <Path Data="M7,10L12,15L17,10H7Z"
                                      Width="8" Height="8"
                                      Stretch="Uniform"
                                      Fill="#9CA3AF"
                                      VerticalAlignment="Center"
                                      Margin="4,1,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.ContextMenu>
                    <ContextMenu x:Name="ConnectionContextMenu"
                                 Placement="Bottom"
                                 HorizontalOffset="-2"
                                 VerticalOffset="0">
                        <ContextMenu.Template>
                            <ControlTemplate TargetType="ContextMenu">
                                <Border Background="White"
                                        CornerRadius="8"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="2" BlurRadius="12" Opacity="0.12" Color="#000000" />
                                    </Border.Effect>
                                    <ItemsPresenter Margin="4" />
                                </Border>
                            </ControlTemplate>
                        </ContextMenu.Template>
                        <ContextMenu.Resources>
                            <Style TargetType="Separator">
                                <Setter Property="Height" Value="1" />
                                <Setter Property="Margin" Value="8,4" />
                                <Setter Property="Background" Value="#E2E8F0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Separator">
                                            <Border Background="{TemplateBinding Background}"
                                                    Height="1"
                                                    Margin="{TemplateBinding Margin}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Padding" Value="10,7" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Foreground" Value="#334155" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="MenuItem">
                                            <Border x:Name="ItemBorder"
                                                    Background="Transparent"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}"
                                                    Margin="2"
                                                    SnapsToDevicePixels="True">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0"
                                                                      ContentSource="Icon"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Center" />
                                                    <ContentPresenter Grid.Column="1"
                                                                      ContentSource="Header"
                                                                      VerticalAlignment="Center"
                                                                      RecognizesAccessKey="True" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsHighlighted" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2FF" />
                                                    <Setter Property="Foreground" Value="#4F46E5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ContextMenu.Resources>
                        <MenuItem Header="连接管理..." Click="MenuConnection_Click">
                            <MenuItem.Icon>
                                <Path Data="M12,4A4,4 0 0,0 8,8A4,4 0 0,0 12,12A4,4 0 0,0 16,8A4,4 0 0,0 12,4M12,14C8.42,14 5,15.79 5,18V20H19V18C19,15.79 15.58,14 12,14Z" Width="14" Height="14" Stretch="Uniform" Fill="#64748B" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="重新获取元数据" Click="RefreshMetadata_Click">
                            <MenuItem.Icon>
                                <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4.01,7.58 4.01,12C4.01,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Width="14" Height="14" Stretch="Uniform" Fill="#64748B" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="刷新扩展元数据" Click="RefreshExtensionMetadata_Click">
                            <MenuItem.Icon>
                                <Path Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M10,17L5,12L6.41,10.59L10,14.17L17.59,6.58L19,8L10,17Z" Width="14" Height="14" Stretch="Uniform" Fill="#64748B" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </StackPanel>
    </hc:Window.NonClientAreaContent>

    <hc:Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type model:ModuleTreeItem}"
                                   ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="2,0">
                <TextBlock Text="{Binding Text}"
                           VerticalAlignment="Center"
                           FontSize="13" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate x:Key="FormTabTemplate" DataType="{x:Type model:ModuleTabItem}">
            <Border Background="White" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FFFFFF" Padding="14,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" Background="#EEF2FF" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"
                                      Width="12" Height="12" Stretch="Uniform" Fill="#4F46E5"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Header}"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="#2D5F8A"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Forms}"
                              Style="{StaticResource AppDataGridStyle}"
                              RowHeaderStyle="{StaticResource AppDataGridRowHeaderStyle}"
                              SelectionUnit="CellOrRowHeader"
                              LoadingRow="DataGrid_LoadingRow"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                              MouseDoubleClick="FormDataGrid_MouseDoubleClick"
                              CanUserSortColumns="True"
                              Sorting="DataGrid_Sorting">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="单据标识" Binding="{Binding FormIdentifier}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="FormIdentifier" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="单据名称" Binding="{Binding FormName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="FormName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="类型" Binding="{Binding ModelTypeName}" Width="Auto" MinWidth="60">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="ModelTypeName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="所属子系统" Binding="{Binding SubSystemName}" Width="*" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="SubSystemName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EntityTabTemplate" DataType="{x:Type model:ModuleTabItem}">
            <Border Background="White" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FFFFFF" Padding="14,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" Background="#ECFDF5" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Path Data="M3,3H21V5H3V3M3,7H21V9H3V7M3,11H21V13H3V11M3,15H21V17H3V15M3,19H21V21H3V19Z"
                                          Width="12" Height="12" Stretch="Uniform" Fill="#059669"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding Header}"
                                           FontWeight="SemiBold" FontSize="14"
                                           Foreground="#2D5F8A"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Content="显示所有字段" Click="ShowAllFields_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    FontSize="12" Padding="10,3"
                                    Cursor="Hand" />
                        </DockPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding FormEntities}"
                              Style="{StaticResource AppDataGridStyle}"
                              RowHeaderStyle="{StaticResource AppDataGridRowHeaderStyle}"
                              SelectionUnit="CellOrRowHeader"
                              LoadingRow="DataGrid_LoadingRow"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                              MouseDoubleClick="EntityDataGrid_MouseDoubleClick"
                              CanUserSortColumns="True"
                              Sorting="DataGrid_Sorting">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="表单标识" Binding="{Binding FormIdentifier}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="FormIdentifier" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="单据名称" Binding="{Binding FormName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="FormName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="标识" Binding="{Binding EntityKey}" Width="Auto" MinWidth="60">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="EntityKey" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="ORM实体名" Binding="{Binding EntityEntryName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="EntityEntryName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="实体名称" Binding="{Binding EntityName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="EntityName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="表名" Binding="{Binding EntityTableName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="EntityTableName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="分录主键" Binding="{Binding EntityEntryPkFieldName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="EntityEntryPkFieldName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="元素类型" Binding="{Binding EntityElementTypeName}" Width="*" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="EntityElementTypeName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="FieldTabTemplate" DataType="{x:Type model:ModuleTabItem}">
            <Border Background="White" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FFFFFF" Padding="14,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" Background="#FFF7ED" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path Data="M4,4H6V6H4V4M4,10H6V12H4V10M4,16H6V18H4V16M8,4H20V6H8V4M8,10H20V12H8V10M8,16H20V18H8V16Z"
                                      Width="12" Height="12" Stretch="Uniform" Fill="#D97706"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Header}"
                                       FontWeight="SemiBold" FontSize="14"
                                       Foreground="#2D5F8A"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Fields}"
                              Style="{StaticResource AppDataGridStyle}"
                              RowHeaderStyle="{StaticResource AppDataGridRowHeaderStyle}"
                              SelectionUnit="Cell"
                              LoadingRow="DataGrid_LoadingRow"
                              PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                              MouseDoubleClick="FieldDataGrid_MouseDoubleClick"
                              CanUserSortColumns="True"
                              Sorting="DataGrid_Sorting">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="标识" Binding="{Binding Key}" Width="Auto" MinWidth="60">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="Key" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="Auto" MinWidth="60">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="Name" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="字段名" Binding="{Binding FieldName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="FieldName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="绑定实体属性" Binding="{Binding PropertyName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="PropertyName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="元素类型" Binding="{Binding ElementTypeName}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="ElementTypeName" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="引用对象" Binding="{Binding LookUpObjectDisplay}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="LookUpObjectDisplay" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="枚举类型" Binding="{Binding EnumTypeDisplay}" Width="Auto" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="EnumTypeDisplay" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="拆分表" Binding="{Binding Suffix}" Width="Auto" MinWidth="60">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="Suffix" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="拆分说明" Binding="{Binding SplitDescription}" Width="*" MinWidth="80">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding}" />
                                            <TextBox Tag="SplitDescription" TextChanged="FilterTextBox_TextChanged" FontSize="13" FontWeight="Normal" Padding="3,1" Margin="0,2,0,0" hc:InfoElement.Placeholder="过滤" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EnumTabTemplate" DataType="{x:Type model:ModuleTabItem}">
            <Border Background="White" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FFFFFF" Padding="14,6" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" Background="#F5F3FF" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center">
