                Padding="16,8"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" Background="#F1F5F9" CornerRadius="6" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Data="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.5L20.5,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14Z"
                          Width="14" Height="14" Stretch="Uniform" Fill="#64748B"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="表单名称"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,0,8,0" />
                    <ComboBox Width="80"
                          ItemsSource="{Binding Operators}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="OperatorValue"
                          SelectedItem="{Binding SelectedOperator}"
                          Margin="0,0,8,0" />
                    <Grid Width="260" Margin="0,0,12,0">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchTextBox_KeyDown"
                                 GotFocus="SearchTextBox_GotFocus"
                                 LostFocus="SearchTextBox_LostFocus"
                                 Background="Transparent" />
                        <TextBlock Text="表单名称/标识/表名" Foreground="#9CA3AF" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Visibility="{Binding SearchPlaceholderVisible, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <Button Content="查询"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource ButtonPrimary}" />
                </StackPanel>
            </Border>

            <!-- 状态栏 -->
            <Border DockPanel.Dock="Bottom"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="0,1,0,0"
                Padding="16,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="#64748B"
                               VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar Grid.Column="1"
                             x:Name="RefreshProgressBar"
                             Width="200" Height="14"
                             Minimum="0" Maximum="100" Value="0"
                             Visibility="Collapsed"
                             VerticalAlignment="Center"
                             Margin="8,0,0,0"
                             Foreground="#4F46E5"
                             Background="#E2E8F0" />
                </Grid>
            </Border>

            <!-- 主内容区 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" MinWidth="180" MaxWidth="360" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 侧边栏 -->
                <Border Grid.Column="0"
                    Background="#F8FAFC"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,1,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top"
                            Background="#2D5F8A"
                            Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3,3H21V5H3V3M3,7H21V9H3V7M3,11H21V13H3V11M3,15H21V17H3V15M3,19H21V21H3V19Z"
                                      Width="14" Height="14" Stretch="Uniform" Fill="#CCFFFFFF"
                                      VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="业务模块"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TreeView ItemsSource="{Binding ModuleTree}"
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="#334155">
                            <TreeView.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#4F46E5" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#4F46E5" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#334155" />
                            </TreeView.Resources>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem"
                                   BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="Padding" Value="4,2" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#E2E8F0" />

                <!-- 内容区域 -->
                <Border Grid.Column="2"
                    Background="White"
                    Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 标签头 -->
                        <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0">
                            <DockPanel>
                                <!-- 左侧向左按钮 -->
                                <RepeatButton x:Name="ScrollLeftButton" Click="ScrollLeftButton_Click" DockPanel.Dock="Left"
                                              Width="24" Cursor="Hand" ToolTip="向左滚动"
                                              Background="Transparent" BorderThickness="0" Focusable="False"
                                              VerticalAlignment="Stretch" Delay="200" Interval="100">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="BtnBorder" Background="Transparent" Padding="4,0" SnapsToDevicePixels="True">
                                                <Path Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
                                                      Width="10" Height="10" Stretch="Uniform" Fill="#64748B"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBorder" Property="Background" Value="#E2E8F0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>

                                <!-- 右侧按钮区 -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Stretch">
                                    <RepeatButton x:Name="ScrollRightButton" Click="ScrollRightButton_Click"
                                                  Width="24" Cursor="Hand" ToolTip="向右滚动"
                                                  Background="Transparent" BorderThickness="0" Focusable="False"
                                                  VerticalAlignment="Stretch" Delay="200" Interval="100">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border x:Name="BtnBorder" Background="Transparent" Padding="4,0" SnapsToDevicePixels="True">
                                                    <Path Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                                                          Width="10" Height="10" Stretch="Uniform" Fill="#64748B"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="#E2E8F0" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                    <ToggleButton x:Name="TabListButton"
                                                  Width="28"
                                                  Cursor="Hand"
                                                  ToolTip="切换标签"
                                                  Focusable="False"
                                                  VerticalAlignment="Stretch">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="BtnBorder" Background="Transparent" Padding="6,0" SnapsToDevicePixels="True">
                                                    <Path Data="M7,10L12,15L17,10H7Z" Width="10" Height="10" Stretch="Uniform" Fill="#64748B"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="#E2E8F0" />
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="#E2E8F0" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </StackPanel>

                                <!-- 标签列表（由 code-behind 动态填充） -->
                                <ScrollViewer x:Name="TabScrollViewer"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="False"
                                              PreviewMouseWheel="TabScrollViewer_PreviewMouseWheel" Height="32">
                                    <Grid x:Name="TabListContainer" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                                    </Grid>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- 标签下拉弹出列表 -->
                        <Popup x:Name="TabListPopup"
                           PlacementTarget="{Binding ElementName=TabListButton}"
                           Placement="Bottom"
                           IsOpen="{Binding IsChecked, ElementName=TabListButton, Mode=TwoWay}"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Slide">
                            <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1"
                                MinWidth="220" MaxHeight="400"
                                Margin="0,0,8,0">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="2" BlurRadius="16" Opacity="0.15" Color="#000000" />
                                </Border.Effect>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="打开的标签" FontSize="12" Foreground="#94A3B8"
                                           Margin="12,10,12,6" FontWeight="Medium" />
                                    <ListBox ItemsSource="{Binding OpenTabs}"
                                         SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                                         SelectionChanged="TabListPopup_SelectionChanged"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         MaxHeight="360"
                                         Padding="4">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type model:ModuleTabItem}">
                                                <StackPanel Orientation="Horizontal" Margin="6,3">
                                                    <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#94A3B8" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding TabType}" Value="Form">
                                                                        <Setter Property="Background" Value="#4F46E5" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding TabType}" Value="Entity">
                                                                        <Setter Property="Background" Value="#059669" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding TabType}" Value="Field">
                                                                        <Setter Property="Background" Value="#D97706" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding TabType}" Value="Enum">
                                                                        <Setter Property="Background" Value="#7C3AED" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding TabType}" Value="AllFields">
                                                                        <Setter Property="Background" Value="#2563EB" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding TabType}" Value="BillType">
                                                                        <Setter Property="Background" Value="#B45309" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Text="{Binding Header}" FontSize="14" Foreground="#334155"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="240" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="4,2" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4" SnapsToDevicePixels="True">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F1F5F9" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2FF" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Popup>

                        <!-- 内容区域 -->
                        <Grid x:Name="TabContentPanel" Grid.Row="1" Grid.ColumnSpan="2" />
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  IsHitTestVisible="False">
            <StackPanel hc:Growl.GrowlParent="True"
                    VerticalAlignment="Top"
                    Margin="0,10,10,10" />
        </ScrollViewer>
    </Grid>
</hc:Window>
